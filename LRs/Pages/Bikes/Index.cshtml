@page
@model LRs.Pages_Bikes.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Bike[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bike[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bike[0].Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bike[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bike[0].Image)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Bike) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @(item.Category?.Name ?? "—")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td class="image-cell">
                @if (!string.IsNullOrEmpty(item.Image))
                {
                    <img src="@item.Image" alt="@item.Name" width="100" class="bike-image" />
                }
                else
                {
                    <span class="no-image">Нет фото</span>
                }
            </td>
            <td class="actions-cell">
                <a asp-page="./Edit" asp-route-id="@item.Id" class="action-btn edit-btn">
                    Edit
                </a>
                <a asp-page="./Details" asp-route-id="@item.Id" class="action-btn details-btn">
                    Details
                </a>
                <a asp-page="./Delete" asp-route-id="@item.Id" class="action-btn delete-btn">
                    Delete
                </a>
            </td>
        </tr>
}
    </tbody>
</table>
<div class="d-flex justify-content-center">
    <pager current-page="@Model.PageNo"
           total-pages="@Model.TotalPages"
           admin="true">
    </pager>
</div>

