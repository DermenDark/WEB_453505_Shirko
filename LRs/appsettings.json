{
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5434;Database=postgres;Username=admin;Password=123456"
  },
  "KeycloakData": {
    "Host": "http://localhost:8080",
    "Realm": "Shirko",
    "ClientId": "ShirkoUiClient"
    //"ClientSecret": "738CeD8I4Rda5aj0SkZ9Cr8P9xWTMxAA"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ItemsPerPage": 3,
  "PageSize": 3,
  "UriData": {
    "ApiUri": "https://localhost:7002/api/"
  }
}
