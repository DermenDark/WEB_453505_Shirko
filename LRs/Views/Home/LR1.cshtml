@model IndexViewModel
@{
}
<main class="container">
    <h1>@ViewData["Title"]</h1>
    <h1>Список</h1>

    <ol type="A">
        @for(int i = 0; i < 5; i++)
        {
            <li> элемент @i списка</li>
        }
    </ol>

    <hr>

    <h1>Форма</h1>

    <form method="post" action="">
        <div class="row">
            <div class="col-4">
                <strong>Выберите элемент:</strong>
                <select asp-for="SelectedId"
                        asp-items="@Model.Items"
                        class="form-control w-50">
                    <option value="">-- Выберите --</option>
                </select>
            </div>

            <div class="col-3"></div>
            <div class="col-4">
                <div class="mb-2">
                    <input type="checkbox" name="check1" value="1" id="check1">
                    <label for="check1">Чек-бокс 1</label>
                </div>
                <div class="mb-2">
                    <input type="checkbox" name="check2" value="2" id="check2">
                    <label for="check2">Чек-бокс 2</label>
                </div>


                <div class="mb-3">
                    <input type="radio" name="radio-group" value="radio1" id="radio1">
                    <label for="radio1">Радио-1</label>

                    <input type="radio" name="radio-group" value="radio2" id="radio2" checked>
                    <label for="radio2">Радио-2</label>

                    <input type="radio" name="radio-group" value="radio3" id="radio3">
                    <label for="radio3">Радио-3</label>
                </div>
            </div>
        </div>
                <div class="row mb-2">
                    <div class="col-3">
                        <strong>Логин:</strong>
                    </div>
                    <div class="col-4">
                        <input type="text" name="login" placeholder="Введите имя" class="form-control">
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-3">
                        <strong>Пароль:</strong>
                    </div>
                    <div class="col-4">
                        <input type="password" name="password" placeholder="Введите пароль" class="form-control">
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <input type="submit" value="Отправить" class="btn btn-primary">
                    </div>
                </div>
        </div>
    </form>
</main>