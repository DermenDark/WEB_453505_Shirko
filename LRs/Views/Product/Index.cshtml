@model WEB_453505_Shirko.Domain.Models.ListModel<
WEB_453505_Shirko.Domain.Entities.Bike >

@{
    ViewData["Title"] = "Велосипеды";

    var categories =
        ViewBag.Categories as
            List<WEB_453505_Shirko.Domain.Entities.Category>;

    var currentCategory =
        ViewBag.CurrentCategory as string;

    var selectedCategory = categories?
        .FirstOrDefault(c =>
            c.NormalizedName == currentCategory);
}

<div class="dropdown mb-4">

    <button class="btn btn-secondary dropdown-toggle"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">

        @(selectedCategory != null
                ? selectedCategory.Name
                : "Все категории")

    </button>

    <ul class="dropdown-menu dropdown-menu-dark">

        <li>
            <a class="dropdown-item @(selectedCategory == null ? "active" : "")"
               asp-controller="Product"
               asp-action="Index">
                Все категории
            </a>
        </li>

        <li>
            <hr class="dropdown-divider">
        </li>

        @if (categories != null)
        {
            foreach (var category in categories)
            {
                <li>
                    <a class="dropdown-item @(selectedCategory?.NormalizedName == category.NormalizedName ? "active" : "")"
                       asp-controller="Product"
                       asp-action="Index"
                       asp-route-categoryNormalizedName="@category.NormalizedName">

                        @category.Name

                    </a>
                </li>
            }
        }

    </ul>

</div>

<div id="product-list">
    @await Html.PartialAsync("_ListPartial", Model)
</div>