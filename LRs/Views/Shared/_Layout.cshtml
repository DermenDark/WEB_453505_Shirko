<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LRs</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LRs.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
</head>
<body>
    <header>
        <div class="container-fluid">
            <nav class="navbar bg-dark navbar-expand-md border-bottom border-body"
                 data-bs-theme="dark">

                <div class="container-fluid">
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <partial name="_MenuPartial" />

                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Account"
                                       asp-action="Login"
                                       asp-route-returnUrl="@Context.Request.Path">
                                        Войти
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Account"
                                       asp-action="Register">
                                        Зарегистрироваться
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <partial name="_UserInfoPartial" />
                        }
                    </div>
                </div>
            </nav>
        </div><!-- container - конец -->
    </header>
    <main class="container mt-4">
        @RenderBody()
    </main>
    <footer>
        <div class="container">
            <div class="navbar bg-dark navbar-expand-md border-bottom border-body"
                 data-bs-theme="dark">
                <div class="navbar-nav ms-auto">
                    <a class="nav-item nav-link" href="http://www.facebook.com">
                        <i class="bi bi-facebook" style="font-size: 2rem"></i>
                    </a>
                    <a class="nav-item nav-link" href="http://www.vk.com">
                        <i class="bi bi-vk" style="font-size: 2rem"></i>
                    </a>
                    <a class="nav-item nav-link" href="http://www.twitter.com">
                        <i class="bi bi-twitter" style="font-size: 2rem"></i>
                    </a>
                    <a class="nav-item nav-link" href="http://www.youtube.com">
                        <i class="bi bi-youtube" style="font-size: 2rem"></i>
                    </a>
                    <a class="nav-item nav-link" href="http://www.telegram.org">
                        <i class="bi bi-telegram" style="font-size: 2rem"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", false)
</body>
</html>
