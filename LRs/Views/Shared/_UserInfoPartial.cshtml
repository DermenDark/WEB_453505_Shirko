@{
    var email = User.Claims
        .FirstOrDefault(c => c.Type.Equals(
            "email", StringComparison.OrdinalIgnoreCase))
        ?.Value;

    var username = User.Claims
        .FirstOrDefault(c => c.Type.Equals(
            "preferred_username",
            StringComparison.OrdinalIgnoreCase))
        ?.Value;

    var userName = !string.IsNullOrWhiteSpace(email)
        ? email
        : username ?? User.Identity?.Name ?? "Пользователь";

    var avatar = User.Claims
        .FirstOrDefault(c => c.Type.Equals(
            "avatar", StringComparison.OrdinalIgnoreCase))
        ?.Value;

    if (string.IsNullOrWhiteSpace(avatar))
    {
        avatar = User.Claims
            .FirstOrDefault(c => c.Type.Equals(
                "picture", StringComparison.OrdinalIgnoreCase))
            ?.Value;
    }

    if (string.IsNullOrWhiteSpace(avatar))
    {
        avatar = Url.Content(
            "~/images/default-profile-picture.png");
    }
}

@await Component.InvokeAsync("CartSummary")

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="dropdown ms-4">
        <button class="btn btn-outline-light dropdown-toggle
                           d-flex align-items-center gap-2"
                type="button"
                id="dropdownMenuButton"
                data-bs-toggle="dropdown"
                aria-expanded="false">

            <img src="@avatar"
                 width="32"
                 height="32"
                 alt="Аватар пользователя"
                 class="rounded-circle"
                 style="object-fit: cover;" />

            <span class="text-white">@userName</span>
        </button>

        <ul class="dropdown-menu dropdown-menu-end bg-dark"
            aria-labelledby="dropdownMenuButton">

            <li>
                <span class="dropdown-item-text text-white
                                 d-flex align-items-center gap-2">

                    <img src="@avatar"
                         width="50"
                         height="50"
                         alt="Аватар пользователя"
                         class="rounded-circle"
                         style="object-fit: cover;" />
                    <span>@userName</span>
                </span>
            </li>

            <li>
                <hr class="dropdown-divider border-light" />
            </li>

            <li class="px-2 pb-2">
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">

                    <button id="logout"
                            type="submit"
                            class="btn btn-outline-light w-100">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Logout
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
