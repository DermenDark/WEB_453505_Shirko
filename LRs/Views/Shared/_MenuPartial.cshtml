@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();
}

<a class="navbar-brand"
   asp-controller="Home"
   asp-action="Index">
    WEB_453505
</a>

<ul class="navbar-nav">
    <li class="nav-item">
        <a class="nav-link @(currentController == "Home" ? "active" : "")"
           asp-controller="Home"
           asp-action="Index"
           asp-route-page="LR1">
            LR1
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(currentController == "Product" ? "active" : "")"
           asp-controller="Product"
           asp-action="Index">
            Каталог
        </a>
    </li>

    @if (User.Identity?.IsAuthenticated == true &&
        User.IsInRole("POWER-USER"))
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-page="/Bikes/Index">
                Администрирование
            </a>
        </li>
    }
    <li class="nav-item">
        @await Component.InvokeAsync("CartSummary")
    </li>
</ul>